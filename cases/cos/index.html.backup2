<style>
.password-overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 9999;
}

.password-modal {
  background: white;
  padding: 48px;
  border-radius: 8px;
  max-width: 540px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
}

.password-modal h2 {
  margin: 0 0 16px 0;
  font-size: 28px;
  font-weight: 600;
}

.password-modal .teaser {
  margin: 24px 0 32px 0;
  font-size: 16px;
  line-height: 1.6;
  color: #555;
}

.password-modal input {
  width: 100%;
  padding: 12px 16px;
  font-size: 16px;
  border: 1px solid #ddd;
  border-radius: 4px;
  margin-bottom: 16px;
  box-sizing: border-box;
}

.password-modal button {
  background: #0066cc;
  color: white;
  border: none;
  padding: 12px 32px;
  font-size: 16px;
  border-radius: 4px;
  cursor: pointer;
  font-weight: 600;
}

.password-modal button:hover {
  background: #0052a3;
}

.password-close-btn {
  position: absolute;
  top: 24px;
  right: 24px;
  background: none;
  border: none;
  font-size: 28px;
  color: #999;
  cursor: pointer;
  padding: 0;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.password-close-btn:hover {
  color: #333;
  background: none;
}

.password-modal {
  position: relative;
}

.password-error {
  color: #d9534f;
  font-size: 14px;
  margin-top: 12px;
  display: none;
}

.content-locked {
  display: none;
}

.content-locked.unlocked {
  display: block;
}

.password-overlay.unlocked {
  display: none;
}
</style>
</head>
