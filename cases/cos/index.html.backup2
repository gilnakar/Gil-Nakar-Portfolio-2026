<script src="../../script.js"></script>
<script>
function checkPassword() {
  const input = document.getElementById('passwordInput').value;
  const correctPassword = 'blgcyNAKAR1';
  
  if (input === correctPassword) {
    document.getElementById('passwordOverlay').classList.add('unlocked');
    document.getElementById('lockedContent').classList.add('unlocked');
  } else {
    document.getElementById('passwordError').style.display = 'block';
    document.getElementById('passwordInput').value = '';
    document.getElementById('passwordInput').focus();
  }
}

function closePasswordModal() {
  window.history.back();
}

document.getElementById('passwordInput').addEventListener('keypress', function(event) {
  if (event.key === 'Enter') {
    checkPassword();
  }
});

document.getElementById('passwordOverlay').addEventListener('click', function(event) {
  if (event.target === this) {
    closePasswordModal();
  }
});
</script>
</body>
